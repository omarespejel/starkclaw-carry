NODE_ENV=development
LOG_LEVEL=debug
RUN_MODE=paper

STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
STARKNET_ACCOUNT_ADDRESS=0x1234567890abcdef
STARKNET_PRIVATE_KEY=0xabcdef1234567890

AVNU_API_KEY=

EXTENDED_API_KEY=
EXTENDED_PUBLIC_KEY=
EXTENDED_PRIVATE_KEY=
EXTENDED_VAULT_NUMBER=
EXTENDED_CLIENT_ID=
EXTENDED_BASE_URL=https://api.starknet.extended.exchange
EXTENDED_API_PREFIX=/api/v1
EXTENDED_ACCOUNT_WS_URL=wss://api.starknet.extended.exchange/stream.extended.exchange/v1/account
EXTENDED_FUNDING_WS_TEMPLATE=wss://api.starknet.extended.exchange/stream.extended.exchange/v1/funding/{market}
EXTENDED_TESTNET_BASE_URL=https://api.starknet.sepolia.extended.exchange
EXTENDED_DEFAULT_RATE_LIMIT_RPM=1000
EXTENDED_PING_INTERVAL_SECONDS=15
EXTENDED_PONG_TIMEOUT_SECONDS=10

MARKET=ETH-USD
MAX_NOTIONAL_USD=1000
LOOP_INTERVAL_MS=5000
JOURNAL_DIR=./artifacts/journal

BRIDGE_ENABLED=false
